{
  "name": "mustard-seed-bookmark",
  "description": "芥子书签（Mustard Seed Bookmark）：芥子纳须弥，AI驱动的智能书签管理扩展，支持智能推荐、批量重命名与多语言界面",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "postinstall": "wxt prepare"
  },
